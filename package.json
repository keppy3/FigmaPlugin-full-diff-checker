{
  "name": "figma-plugin-full-diff-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Before/After間の見た目差分を検出し、比較対象のFigmaファイル内に実ノードとしてレポートページを生成するプラグイン",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
